# Port the Express server listens on
PORT=3001

# Public HTTPS URL Crowdin will load this app from.
PUBLIC_BASE_URL=https://your-tunnel-or-domain.example.com

# Upstash Redis (same database the sibling crowdin-subtitle-timing-app uses
# is fine - this app stores its installation records under a different key,
# "prep-installations", so there's no collision).
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Crowdin OAuth Application credentials for THIS app's own registration
# (Organization Settings -> OAuth apps -> "Subtitle Source Prep"). These are
# separate from the sibling app's OAuth credentials - each Crowdin App has
# its own OAuth Application, its own clientId/secret, and its own installed
# webhook payload.
CROWDIN_CLIENT_ID=your-oauth-app-client-id
CROWDIN_CLIENT_SECRET=your-oauth-app-client-secret
